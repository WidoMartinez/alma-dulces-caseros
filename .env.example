# Base de datos MySQL
DATABASE_URL=mysql://usuario:contraseña@localhost:3306/alma_dulces

# Secreto para JWT (generar uno seguro aleatorio)
JWT_SECRET=tu-secreto-jwt-muy-seguro-aqui-cambiar

# Entorno de ejecución
NODE_ENV=development

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# APIs opcionales (si se usan)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# NOTA: Las siguientes variables de OAuth YA NO SON NECESARIAS
# El sistema ahora usa autenticación local con username/password
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=
# OWNER_OPEN_ID=
